{
  "$defs": {
    "CellResult": {
      "additionalProperties": false,
      "properties": {
        "cell": {
          "minLength": 1,
          "title": "Cell",
          "type": "string"
        },
        "differential_missingness": {
          "default": false,
          "title": "Differential Missingness",
          "type": "boolean"
        },
        "missing_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Rate"
        },
        "n": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N"
        },
        "power": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Power"
        },
        "sensitivity": {
          "anyOf": [
            {
              "patternProperties": {
                "^[a-z0-9][a-z0-9_]*$": {
                  "$ref": "#/$defs/StatResult"
                }
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensitivity"
        },
        "tests": {
          "patternProperties": {
            "^[a-z0-9][a-z0-9_]*$": {
              "$ref": "#/$defs/StatResult"
            }
          },
          "title": "Tests",
          "type": "object"
        }
      },
      "required": [
        "cell",
        "tests"
      ],
      "title": "CellResult",
      "type": "object"
    },
    "CredibleChange": {
      "additionalProperties": false,
      "description": "One credible favourite change (H1d alignment): its unit, the interface that\nshowed it and whether the new favourite has the higher u (null: a tie in u).",
      "properties": {
        "higher_u": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Higher U"
        },
        "interface": {
          "enum": [
            "text",
            "structured",
            "browser_tool"
          ],
          "title": "Interface",
          "type": "string"
        },
        "pair": {
          "minLength": 1,
          "title": "Pair",
          "type": "string"
        },
        "task": {
          "minLength": 1,
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "pair",
        "task",
        "interface",
        "higher_u"
      ],
      "title": "CredibleChange",
      "type": "object"
    },
    "McEstimate": {
      "additionalProperties": false,
      "description": "One Monte Carlo estimate of a ``monte_carlo`` check, with its Monte Carlo SE.",
      "properties": {
        "estimate": {
          "title": "Estimate",
          "type": "number"
        },
        "se": {
          "minimum": 0.0,
          "title": "Se",
          "type": "number"
        }
      },
      "required": [
        "estimate",
        "se"
      ],
      "title": "McEstimate",
      "type": "object"
    },
    "Rerun": {
      "additionalProperties": false,
      "description": "The one rerun of a ``contains`` cell whose interval was too wide (A12 §6.3).",
      "properties": {
        "ci": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Ci",
          "type": "array"
        },
        "ci_level": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Ci Level",
          "type": "number"
        },
        "n": {
          "exclusiveMinimum": 0,
          "title": "N",
          "type": "integer"
        }
      },
      "required": [
        "n",
        "ci",
        "ci_level"
      ],
      "title": "Rerun",
      "type": "object"
    },
    "StatResult": {
      "additionalProperties": false,
      "properties": {
        "changes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CredibleChange"
          },
          "title": "Changes",
          "type": "array"
        },
        "ci": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci"
        },
        "ci_level": {
          "anyOf": [
            {
              "exclusiveMaximum": 1.0,
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Level"
        },
        "counts": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_]*$": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "title": "Counts",
          "type": "object"
        },
        "estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimate"
        },
        "metrics": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_]*$": {
              "type": "number"
            }
          },
          "title": "Metrics",
          "type": "object"
        },
        "monte_carlo": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_]*$": {
              "items": {
                "$ref": "#/$defs/McEstimate"
              },
              "type": "array"
            }
          },
          "title": "Monte Carlo",
          "type": "object"
        },
        "n": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N"
        },
        "p_against": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Against"
        },
        "p_support": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Support"
        },
        "p_value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Value"
        },
        "rerun": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rerun"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "share": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Share"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "title": "StatResult",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "additionalProperties": {
        "patternProperties": {
          "^[a-z0-9][a-z0-9_]*$": {
            "items": {
              "$ref": "#/$defs/CellResult"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "propertyNames": {
        "enum": [
          "H1a",
          "H1b",
          "H1c",
          "H1d",
          "H1e",
          "H2a",
          "H2b",
          "H2c",
          "H3a",
          "H3b",
          "H3c",
          "H4a",
          "H4b",
          "H4c",
          "H4d",
          "H5a",
          "H5b"
        ]
      },
      "title": "Claims",
      "type": "object"
    },
    "register_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Register Sha256"
    },
    "results_version": {
      "const": 1,
      "title": "Results Version",
      "type": "integer"
    }
  },
  "required": [
    "results_version",
    "claims"
  ],
  "title": "ResultsFile",
  "type": "object"
}
